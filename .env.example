DATABASE_URL="file:./dev.db"
# Evolution API / WhatsApp Web (values stay on the server)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=bill-reminder
# Número com DDI/DDD (5535...) ou ID de grupo (123456@g.us)
EVOLUTION_RECIPIENT=
# Protects POST /api/reminders/run; use a long random value in production
CRON_SECRET=
# Defaults: days before due date; overdue days after due date
REMINDER_BEFORE_DAYS=3
REMINDER_OVERDUE_DAYS=1
WHATSAPP_ENABLED=false
